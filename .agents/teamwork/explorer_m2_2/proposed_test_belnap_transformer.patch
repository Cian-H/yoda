+    def test_coupled_routing_refutation_preservation(self) -> None:
+        """Verifies that 2x2 coupled routing preserves negative refutation evidence
+        from key tokens when attended by coherent query affinity.
+        """
+        attn = BelnapAttention(d_model=16, n_heads=1)
+        q = BelnapState(e_pos=torch.ones(1, 1, 16), e_neg=torch.zeros(1, 1, 16))
+        kv = BelnapState(e_pos=torch.zeros(1, 1, 16), e_neg=torch.ones(1, 1, 16))
+
+        out = attn(q, kv)
+        # Under coupled routing: agg_neg = a_pos * V_neg + a_neg * V_pos
+        # Coherent positive query attending to refuting key yields negative evidence
+        assert out.e_neg.mean().item() > 0.1
+
+    def test_coupled_routing_double_negation_symmetry(self) -> None:
+        """Verifies that negating query inverts output evidence polarity (double negation)."""
+        d_model = 16
+        attn = BelnapAttention(d_model=d_model, n_heads=2)
+        # Tie weights across positive and negative paths to verify algebraic symmetry
+        attn.w_q_neg.weight.data.copy_(attn.w_q_pos.weight.data)
+        attn.w_q_neg.bias.data.copy_(attn.w_q_pos.bias.data)
+        attn.w_k_neg.weight.data.copy_(attn.w_k_pos.weight.data)
+        attn.w_k_neg.bias.data.copy_(attn.w_k_pos.bias.data)
+        attn.w_v_neg.weight.data.copy_(attn.w_v_pos.weight.data)
+        attn.w_v_neg.bias.data.copy_(attn.w_v_pos.bias.data)
+        attn.w_out_neg.weight.data.copy_(attn.w_out_pos.weight.data)
+        attn.w_out_neg.bias.data.copy_(attn.w_out_pos.bias.data)
+        attn.norm_neg.weight.data.copy_(attn.norm_pos.weight.data)
+        attn.norm_neg.bias.data.copy_(attn.norm_pos.bias.data)
+
+        q = BelnapState(e_pos=torch.rand(2, 3, d_model), e_neg=torch.rand(2, 3, d_model))
+        kv = BelnapState(e_pos=torch.rand(2, 4, d_model), e_neg=torch.rand(2, 4, d_model))
+
+        out_orig = attn(q, kv)
+        out_neg_q = attn(q.negate(), kv)
+
+        assert torch.allclose(out_neg_q.e_pos, out_orig.e_neg, atol=1e-5)
+        assert torch.allclose(out_neg_q.e_neg, out_orig.e_pos, atol=1e-5)
+
 
 class TestBelnapFFN:
