# Common Python / Nix project ignores
# Virtual environment
.venv/
.direnv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/

# Jupyter / marimo notebooks checkpoints
.ipynb_checkpoints/
__marimo__/

# VS Code / IDE settings
.vscode/
.idea/

# Build artifacts
build/
dist/
*.egg-info/

# Test caches
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Nix files generated by devenv
.devenv/

# macOS system files
.DS_Store

# Training logs & tracking
lightning_logs/
wandb/
runs/
*.log

# Project artifact data & models (keep directory structure tracked with .gitkeep)
data/*
!data/.gitkeep
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

checkpoints/*
!checkpoints/.gitkeep

plots/*
!plots/.gitkeep
