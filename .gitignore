# Common Python / Nix project ignores
# Virtual environment
.venv/
venv/
ENV/
env/
.direnv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.ruff_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
wheels/
*.whl

# Test / coverage
.pytest_cache/
.tox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.pyright/
.pytype/

# Jupyter / marimo notebooks checkpoints
.ipynb_checkpoints/
__marimo__/

# Environment / secrets
.env
.env.*
!.env.example

# VS Code / IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

# Nix files generated by devenv
.devenv/

# OS
.DS_Store
Thumbs.db

# Training logs & tracking
lightning_logs/
wandb/
runs/
*.log

# Project artifact data & models (keep directory structure tracked with .gitkeep)
data/*
!data/.gitkeep
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

checkpoints/*
!checkpoints/.gitkeep

plots/*
!plots/.gitkeep
